auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: {{rtl433_data_pipeline_url}}/callback
  authorization_url: {{keycloak_url}}/realms/rtl433dp/protocol/openid-connect/auth
  access_token_url: {{keycloak_url}}/realms/rtl433dp/protocol/openid-connect/token
  refresh_token_url: 
  client_id: rtl433dp-api
  client_secret: BhNI2RsOIkpf6yrdMJcGnfmd3bKz4bZP
  scope: openid
  state: 
  pkce: false
  credentials_placement: basic_auth_header
  credentials_id: credentials
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}
